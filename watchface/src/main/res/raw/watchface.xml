      </Complication>
      <Complication type="RANGED_VALUE">
        <Group x="0" y="0" width="100" height="60">
          <PartText x="0" y="15" width="100" height="30" alignment="CENTER">
            <Text><Template>%s</Template><Parameter expression="[COMPLICATION.TEXT]" /></Text>
            <Font family="hud_bold" size="16" color="#ffd700" />
          </PartText>
        </Group>
      </Complication>
      <Complication type="EMPTY" />
    </ComplicationSlot>

