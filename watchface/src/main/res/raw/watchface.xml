<?xml version='1.0' encoding='utf-8'?>
<WatchFace width="450" height="450" clipShape="CIRCLE">
  <Metadata key="CLOCK_TYPE" value="ANALOG" />
  <Metadata key="PREVIEW_TIME" value="10:08:30" />
  <UserConfigurations>
    <ColorConfiguration id="palette" displayName="palette" defaultValue="mordor">
      <ColorOption id="mordor" displayName="mordor" colors="#ffaa00 #ff4400 #ffd700 #884400" />
      <ColorOption id="elven" displayName="elven" colors="#88e0ff #00aaff #c2f0ff #226688" />
      <ColorOption id="gondor" displayName="gondor" colors="#ffffff #cccccc #e6e6e6 #666666" />
    </ColorConfiguration>
    <BooleanConfiguration id="seconds" displayName="seconds" defaultValue="TRUE" />
    <BooleanConfiguration id="background" displayName="background" defaultValue="TRUE" />
    <BooleanConfiguration id="automatic_icons" displayName="automatic_icons" defaultValue="TRUE" />
  </UserConfigurations>

  <Scene backgroundColor="#000000">
    <!-- Map Background -->
    <Group name="map_background" x="0" y="0" width="450" height="450">
      <BooleanConfiguration id="background">
        <BooleanOption id="TRUE">
          <PartImage x="0" y="0" width="450" height="450">
            <Image resource="lotr_map_background" />
            <Variant mode="AMBIENT" target="alpha" value="75" />
          </PartImage>
        </BooleanOption>
      </BooleanConfiguration>
    </Group>

    <!-- One Ring Tengwar Script Ring -->
    <Group name="one_ring" x="0" y="0" width="450" height="450">
      <PartImage x="0" y="0" width="450" height="450">
        <Image resource="lotr_ring_tengwar" />
        <Variant mode="AMBIENT" target="alpha" value="180" />
      </PartImage>
    </Group>

    <!-- Center Digital Date & Time -->
    <Group name="center_digital" x="125" y="115" width="200" height="60">
      <PartText x="0" y="0" width="200" height="24" alignment="CENTER">
        <Text>
          <Template>%s</Template>
          <Parameter expression="[DAY_OF_WEEK_S] + ' ' + [DAY_IN_MONTH]" />
        </Text>
        <Font family="hud_bold" size="14" color="#ffd700">
          <Variant mode="AMBIENT" target="color" value="#cccccc" />
        </Font>
      </PartText>
      <PartText x="0" y="24" width="200" height="36" alignment="CENTER">
        <Text>
          <Template>%s:%s</Template>
          <Parameter expression="[HOUR_0_23_Z]" />
          <Parameter expression="[MINUTE_Z]" />
        </Text>
        <Font family="hud_bold" size="26" color="#ffaa00">
          <Variant mode="AMBIENT" target="color" value="#ffffff" />
        </Font>
      </PartText>
    </Group>

    <!-- 8 Complication Slots -->
    <!-- Slot 01: Top Slot -->
    <ComplicationSlot id="0" x="175" y="45" width="100" height="60" slotId="1" supportedTypes="LONG_TEXT SHORT_TEXT RANGED_VALUE EMPTY" displayName="top_slot">
      <BoundingBox x="0" y="0" width="100" height="60" />
      <Variant mode="AMBIENT" target="alpha" value="180" />
      <Complication type="SHORT_TEXT">
        <Group x="0" y="0" width="100" height="60">
          <PartText x="0" y="10" width="100" height="20" alignment="CENTER">
            <Text><Template>%s</Template><Parameter expression="[COMPLICATION.TITLE]" /></Text>
            <Font family="hud_bold" size="12" color="#a86528" />
          </PartText>
          <PartText x="0" y="30" width="100" height="25" alignment="CENTER">
            <Text><Template>%s</Template><Parameter expression="[COMPLICATION.TEXT]" /></Text>
            <Font family="hud_bold" size="16" color="#ffd700" />
          </PartText>
        </Group>
      </Complication>
      <Complication type="LONG_TEXT">
        <Group x="0" y="0" width="100" height="60">
          <PartText x="0" y="10" width="100" height="20" alignment="CENTER">
            <Text><Template>%s</Template><Parameter expression="[COMPLICATION.TITLE]" /></Text>
