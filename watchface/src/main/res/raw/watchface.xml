    <ComplicationSlot x="175" y="45" width="100" height="60" slotId="0" supportedTypes="LONG_TEXT SHORT_TEXT RANGED_VALUE EMPTY" displayName="top_slot">
      <BoundingBox x="0" y="0" width="100" height="60" />
      <Variant mode="AMBIENT" target="alpha" value="180" />
      <Complication type="SHORT_TEXT">
        <Group name="slot_0_short_text" x="0" y="0" width="100" height="60">
          <PartText x="0" y="10" width="100" height="20">
            <Text align="CENTER">
              <Font family="hud_bold" size="12" color="#a86528">
                <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
              </Font>
            </Text>
          </PartText>
          <PartText x="0" y="30" width="100" height="25">
            <Text align="CENTER">
              <Font family="hud_bold" size="16" color="#ffd700">
                <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
              </Font>
            </Text>
